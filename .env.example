# Copy to `.env.local` and fill in real values (preferred for secrets).
# Next.js and `bun run seed:admin` / `migrate:firebase` both load `.env.local`.

# App
NEXT_PUBLIC_SITE_URL=https://portfolio.reactiveferdous.com
NEXT_PUBLIC_FORMSPREE_ID=xvoebwnj

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/reactive-ferdous?retryWrites=true&w=majority

# JWT (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Single admin user (used by `bun run seed:admin`)
ADMIN_EMAIL=contact@reactiveferdous.com
ADMIN_PASSWORD=change-me-strong-password

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reactive-ferdous
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN_OR_r2_dev_URL

# Optional: contact confirmation email (Resend)
RESEND_API_KEY=

# --- Optional: one-time import from the OLD Vite site only ---
# The Next.js app does NOT use Firebase. Skip these if you will add
# content via /admin instead of running `bun run migrate:firebase`.
# FIREBASE_PROJECT_ID=

